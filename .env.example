# Server-side secrets. All optional; rooms work without them.
GROQ_API_KEY=your_groq_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
PORT=3000
# Server-only Supabase secret key (sb_secret_… or the service_role key). Needed once sql/016 has run:
# the assistant and TURN quotas are then recorded by the server alone. Never in the browser or supabase.config.json.
SUPABASE_SERVICE_ROLE_KEY=

# Public values for your own Supabase project. Leave unset to use supabase.config.json.
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Cloudflare Turnstile site key, for the captcha on auth requests (see README).
# PUBLIC_TURNSTILE_SITE_KEY=0x...
