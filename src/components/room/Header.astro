<header class="app-header">
            <div class="header-left">
                <a href="/" class="brand" aria-label="Flow home">flow<span class="brand-period">.</span></a>
                <div class="room-info">
                    <span id="room-name">Room: <span class="highlight" id="header-room-code">----</span></span>
                    <span class="participant-count"><span class="dot green"></span> <span id="count">1</span> Online</span>
                </div>
            </div>
            <div class="header-right" style="display: flex; gap: 8px; align-items: center;">
                <select id="theme-picker" class="brutal-input" aria-label="Room atmosphere">
                    <option value="forest">Forest</option>
                    <option value="midnight">Midnight</option>
                    <option value="warm">Warm</option>
                    <option value="aqua">Aqua</option>
                    <option value="amethyst">Amethyst</option>
                </select>
                <button id="share-link-btn" class="btn btn-secondary">Invite</button>
                <button id="leave-btn" class="btn btn-danger">Leave</button>
            </div>
        </header>
