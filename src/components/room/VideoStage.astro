<main class="main-workspace center-stage">
                <div class="stage-header"><div><h1>Study room</h1><p>A shared space for uninterrupted work.</p></div><span id="connection-status" class="stage-status" role="status" data-state="connecting">Connecting…</span></div>
                <div id="room-guidance" class="room-guidance"><span>Your room is ready. Invite your study group to join.</span><button id="invite-empty-btn" class="btn btn-secondary">Invite people</button></div>
                <div class="video-grid" id="video-grid">
                    <div class="video-wrapper" id="video-wrapper-local">
                        <video id="local-video" autoplay muted playsinline></video>
                        <span class="name-tag">You</span>
                        <div class="dummy-placeholder hidden" id="local-dummy-placeholder">
                             <div class="avatar" style="width:64px; height:64px; font-size:2rem; border-radius:50%;" id="local-dummy-avatar">?</div>
                             <div class="text">Camera Unavailable</div>
                        </div>
                        <details class="reactions-menu">
                            <summary class="icon-btn" aria-label="Reactions and raise hand"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 14a4 4 0 0 0 8 0"/><path d="M8 9h1m6 0h1"/></svg></summary>
                            <div class="reaction-bar">
                            <button class="icon-btn reaction-btn" data-emoji="👍" aria-label="Thumbs up" style="width:30px; height:30px; font-size: 15px;">👍</button>
                            <button class="icon-btn reaction-btn" data-emoji="❤️" aria-label="Heart" style="width:30px; height:30px; font-size: 15px;">❤️</button>
                            <button class="icon-btn reaction-btn" data-emoji="😂" aria-label="Laugh" style="width:30px; height:30px; font-size: 15px;">😂</button>
                            <button class="icon-btn reaction-btn" data-emoji="🎉" aria-label="Celebrate" style="width:30px; height:30px; font-size: 15px;">🎉</button>
                            <button id="toggle-hand" class="icon-btn" aria-label="Raise hand" style="width:30px; height:30px; font-size: 15px;" title="Raise hand">✋</button>
                            </div>
                        </details>
                        <div style="position: absolute; bottom: 12px; right: 12px; display: flex; gap: 8px; z-index: 20;">
                            <button id="toggle-mic" class="icon-btn active" aria-label="Toggle microphone"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg></button>
                            <button id="toggle-cam" class="icon-btn active" aria-label="Toggle camera"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg></button>
                        </div>
                    </div>
                </div>
            </main>
