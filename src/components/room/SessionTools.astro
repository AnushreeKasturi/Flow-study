---
import GitHubStar from '../GitHubStar.astro';
---
<aside class="right-sidebar" aria-label="Room tools">
    <div class="tabs-header" role="tablist" aria-label="Room tools">
        <button id="tasks-tab-button" class="tab-btn active" data-tab="tasks-tab" role="tab" aria-controls="tasks-tab" aria-selected="true">Tasks</button>
        <button id="chat-tab-button" class="tab-btn" data-tab="chat-tab" role="tab" aria-controls="chat-tab" aria-selected="false" tabindex="-1">Chat</button>
        <button id="sound-tab-button" class="tab-btn" data-tab="sound-tab" role="tab" aria-controls="sound-tab" aria-selected="false" tabindex="-1">Sound</button>
    </div>

    <div id="tasks-tab" class="tab-content active" role="tabpanel" aria-labelledby="tasks-tab-button">
        <div class="input-row">
            <input type="text" id="new-task-input" class="input" aria-label="New shared task" placeholder="Add a shared task…" maxlength="100">
            <button id="add-task-btn" class="icon-btn active" aria-label="Add task">+</button>
        </div>
        <div class="progress-heading"><span>Session progress</span><span id="room-task-progress-text">0%</span></div>
        <div class="task-progress-bar"><div id="room-task-progress-fill" class="task-progress-fill" style="width: 0%;"></div></div>
        <p id="task-sync-status" class="panel-description" role="status">Loading room tasks…</p>
        <button id="retry-tasks-btn" class="btn hidden">Retry loading tasks</button>
        <ul class="task-list" id="room-task-list"></ul>
    </div>

    <div id="chat-tab" class="tab-content" role="tabpanel" aria-labelledby="chat-tab-button">
        <div id="chat-messages" role="log" aria-label="Room messages"></div>
        <div id="ai-pending" class="panel-description hidden" role="status">Study assistant is thinking…</div>
        <div class="chat-compose">
            <textarea id="chat-input" placeholder="Write to your room…" aria-label="Message to room" aria-describedby="chat-compose-help" rows="2" maxlength="300"></textarea>
            <div class="chat-compose-actions">
                <span id="chat-compose-help"><kbd>/ai</kbd> Study assistant</span>
                <button id="send-chat-btn" class="btn btn-primary" title="Send message (Enter)">Send</button>
            </div>
        </div>
    </div>

    <div id="sound-tab" class="tab-content" role="tabpanel" aria-labelledby="sound-tab-button">
        <section class="sound-block" aria-labelledby="sound-heading">
            <h2 id="sound-heading" class="panel-heading">Soundscape</h2>
            <p class="panel-description">Steady noise to mask distractions. Only you hear it.</p>
            <div class="segmented" role="group" aria-label="Soundscape">
                <button type="button" data-sound="brown" aria-pressed="false">Brown</button>
                <button type="button" data-sound="pink" aria-pressed="false">Pink</button>
                <button type="button" data-sound="white" aria-pressed="false">White</button>
            </div>
            <label class="volume"><span>Volume</span><input type="range" id="sound-volume" min="0" max="100" value="40"></label>
        </section>
        <section class="sound-block ambience-panel" aria-labelledby="audio-heading">
            <h2 id="audio-heading" class="panel-heading">Room audio</h2>
            <p class="panel-description">Share a link; everyone plays it on their own.</p>
            <div class="segmented" role="group" aria-label="Audio provider">
                <button type="button" data-audio-provider="youtube" aria-pressed="true">YouTube</button>
                <button type="button" data-audio-provider="spotify" aria-pressed="false">Spotify</button>
            </div>
            <div class="input-row">
                <input type="url" id="youtube-url-input" class="input" placeholder="YouTube link" aria-label="YouTube video or playlist link">
                <button id="sync-youtube-btn" class="btn" aria-label="Share audio with room">Share</button>
            </div>
            <div id="youtube-empty" class="audio-empty"><p>Paste a video or playlist link, or start with a lofi stream.</p><button id="load-lofi-btn" type="button" class="btn">Play lofi radio</button></div>
            <iframe id="youtube-iframe" class="hidden" title="YouTube background audio" width="100%" height="152" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            <div id="spotify-empty" class="audio-empty hidden"><p>Paste a Spotify track, playlist, album, or podcast link to load the player.</p></div>
            <iframe id="spotify-iframe" class="hidden" title="Spotify background audio" width="100%" height="152" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
        </section>
        <div class="room-support"><GitHubStar label="Flow is open source" /></div>
    </div>
</aside>
