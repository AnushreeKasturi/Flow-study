---
import GitHubStar from '../GitHubStar.astro';
import Icon from '../Icon.astro';
import { SUBJECTS, CAMERAS, VIBES } from '../../client/modules/board-options';
const shortcuts = [['S', 'Start or pause the timer'], ['F', 'Enter or leave focus mode'], ['M', 'Mute or unmute your microphone'], ['V', 'Turn your camera on or off'], ['?', 'Show these shortcuts'], ['Esc', 'Close a dialog']];
---
<div id="modal-overlay" class="modal-overlay">
    <div id="join-modal" class="modal lobby" role="dialog" aria-modal="true" aria-labelledby="join-title">
        <div class="lobby-intro">
            <a href="/" class="brand">flow<i></i></a>
            <div><h1 id="join-title">A room for<br>your next idea.</h1><p>Bring a goal. Invite your study group. Make progress together.</p></div>
            <p class="lobby-intro-note">Your timer, tasks, sound, and study partners,<br>all in one focused space.</p>
        </div>
        <div class="lobby-form">
            <!-- First visit only: shown until the account has a display name. -->
            <form id="welcome-step" class="hidden">
                <h2>First, what should we call you?</h2>
                <p class="lobby-description">Your study partners see this name on your video tile and next to your tasks.</p>
                <label for="welcome-name-input">Your name</label>
                <input type="text" id="welcome-name-input" class="input" maxlength="40" autocomplete="nickname" required>
                <p id="welcome-error" class="inline-error hidden" role="alert"></p>
                <button id="welcome-save-btn" class="btn btn-primary btn-lg btn-block">Save and continue</button>
                <p class="lobby-note">You can change it any time from your profile.</p>
            </form>
            <div id="lobby-step">
                <h2 id="lobby-greeting">Settle into your session.</h2>
                <div class="lobby-home"><p id="lobby-recap"></p><p id="lobby-today"></p><p id="lobby-board"></p></div>
                <label for="room-code-input">Room code</label>
                <input type="text" id="room-code-input" class="input room-code-field" aria-describedby="lobby-error" placeholder="Enter 6-character code" maxlength="6" autocomplete="off" spellcheck="false">
                <label for="room-pin-input">Room PIN <span class="muted">(if required)</span></label>
                <input type="password" id="room-pin-input" class="input" placeholder="4-digit PIN" maxlength="4" inputmode="numeric" autocomplete="off">
                <p id="lobby-error" class="inline-error hidden" role="alert"></p>
                <button id="join-btn" class="btn btn-primary btn-lg btn-block" disabled>Join room</button>
                <div class="divider"><span>Or start your own</span></div>
                <button id="host-btn" class="btn btn-lg btn-block" disabled>Create a room</button>
                <p class="lobby-note">Type a 4-digit PIN above first if you want the new room locked.</p>
            </div>
            <div class="lobby-footer"><a href="#" id="logout-link" class="logout-link">Log out</a><a href="/groups.html" class="logout-link">Browse study groups</a><GitHubStar /></div>
        </div>
    </div>

    <div id="timer-settings-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="timer-settings-title">
        <div class="modal-head"><h2 id="timer-settings-title">Timer settings</h2><button id="close-timer-settings-btn" class="icon-btn quiet" aria-label="Close timer settings"><Icon name="close" /></button></div>
        <p class="dialog-description">Lengths apply to everyone in the room.</p>
        <div class="settings-grid">
            <div><label for="setting-focus-duration">Focus (minutes)</label><input type="number" id="setting-focus-duration" required class="input" value="25" min="1" max="120"></div>
            <div><label for="setting-short-break-duration">Short break (minutes)</label><input type="number" id="setting-short-break-duration" required class="input" value="5" min="1" max="60"></div>
            <div><label for="setting-long-break-duration">Long break (minutes)</label><input type="number" id="setting-long-break-duration" required class="input" value="15" min="1" max="60"></div>
        </div>
        <label class="check"><input type="checkbox" id="setting-notify"><span>Send me a notification when a session ends<small>Only shown while Flow is in a background tab.</small></span></label>
        <button id="save-timer-settings-btn" class="btn btn-primary btn-block">Save Changes</button>
    </div>

    <div id="profile-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="profile-title">
        <div class="modal-head"><h2 id="profile-title">Your profile</h2><button id="close-profile-btn" class="icon-btn quiet" aria-label="Close profile"><Icon name="close" /></button></div>
        <div class="profile-name-form">
            <div id="profile-avatar" class="avatar">?</div>
            <div>
                <label for="profile-display-name-input">Display name</label>
                <div class="input-row">
                    <input type="text" id="profile-display-name-input" required class="input" placeholder="Your name" maxlength="40">
                    <button id="save-profile-name-btn" class="btn btn-primary">Save Name</button>
                </div>
            </div>
        </div>
        <div id="profile-stats" aria-live="polite"></div>
        <p class="profile-footnote">Finished focus sessions are saved to your history. Time from a session still in progress counts while this page stays open.</p>
    </div>

    <div id="timer-alert-modal" class="modal hidden centered" role="dialog" aria-modal="true" aria-labelledby="timer-alert-title">
        <h2 id="timer-alert-title">Time’s up</h2>
        <p id="timer-alert-msg" class="dialog-description">Great focus session.</p>
        <button id="close-timer-alert-btn" class="btn btn-primary btn-block">Continue</button>
    </div>

    <div id="leave-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="leave-title">
        <h2 id="leave-title">Leave this session?</h2>
        <p class="dialog-description">Your camera and microphone will disconnect. You can rejoin with the room code; saved shared tasks stay in the room.</p>
        <div class="dialog-actions">
            <button id="cancel-leave-btn" class="btn">Stay in room</button>
            <button id="confirm-leave-btn" class="btn btn-danger">Leave room</button>
        </div>
    </div>

    <div id="invite-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="invite-title">
        <h2 id="invite-title">Invite your study group</h2>
        <p class="dialog-description">Anyone with this link can join after signing in. Room code <strong id="invite-code-text"></strong>.</p>
        <label for="invite-link-input">Room link</label>
        <div class="input-row">
            <input id="invite-link-input" class="input" readonly>
            <button id="copy-invite-btn" class="btn btn-primary"><Icon name="copy" size={16} /><span>Copy link</span></button>
        </div>
        <form id="board-form" class="board-form">
            <h3>Or open it to the study-groups board</h3>
            <p id="board-status" class="panel-description" role="status">Anyone signed in can find it and take a seat. Rooms with a PIN can’t be listed.</p>
            <label for="board-topic">What are you studying?</label>
            <input type="text" id="board-topic" class="input" minlength="3" maxlength="80" required placeholder="Organic chemistry revision">
            <div class="board-form-grid">
                <select id="board-subject" class="input" aria-label="Subject">{SUBJECTS.map(([id, name]) => <option value={id} selected={id === 'other'}>{name}</option>)}</select>
                <select id="board-camera" class="input" aria-label="Cameras">{CAMERAS.map(([id, name]) => <option value={id}>{name}</option>)}</select>
                <select id="board-vibe" class="input" aria-label="Talking">{VIBES.map(([id, name]) => <option value={id}>{name}</option>)}</select>
            </div>
            <div class="board-form-row">
                <label for="board-seats">Seats</label>
                <select id="board-seats" class="input" aria-label="Seats, including you">{[2, 3, 4, 5, 6].map(n => <option value={n} selected={n === 4}>{n}</option>)}</select>
                <button id="board-list-btn" class="btn btn-primary">List this room</button>
                <button type="button" id="board-unlist-btn" class="btn hidden">Remove from the board</button>
            </div>
            <label id="board-closed-row" class="check hidden"><input type="checkbox" id="board-closed"><span>Stop new people joining<small>The listing stays up and shows as closed. People already here are not affected.</small></span></label>
        </form>
        <div class="dialog-actions"><button id="close-invite-btn" class="btn">Done</button></div>
    </div>

    <div id="remove-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="remove-title">
        <h2 id="remove-title">Remove this person?</h2>
        <p id="remove-text" class="dialog-description">They will leave the room now and won’t be able to come back to it.</p>
        <div class="dialog-actions">
            <button id="cancel-remove-btn" class="btn">Keep them</button>
            <button id="confirm-remove-btn" class="btn btn-danger">Remove from room</button>
        </div>
    </div>

    <div id="shortcuts-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title">
        <div class="modal-head"><h2 id="shortcuts-title">Keyboard shortcuts</h2><button id="close-shortcuts-btn" class="icon-btn quiet" aria-label="Close shortcuts"><Icon name="close" /></button></div>
        <dl class="shortcut-list">{shortcuts.map(([key, action]) => <div><dt><kbd>{key}</kbd></dt><dd>{action}</dd></div>)}</dl>
        <p class="profile-footnote">Shortcuts pause while you’re typing.</p>
    </div>
</div>
